# ── Google Places API (New). Sin clave funciona el modo demo con negocios ficticios ──
# La clave se usa solo en el servidor. Restríngela en Google Cloud a "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Nombre y firma de quien envía los mensajes de WhatsApp (aparece en el texto).
RADAR_REMITENTE_NOMBRE=

# Obligatoria si hay GOOGLE_PLACES_API_KEY: clave de acceso a la app (16+ caracteres).
# Sin ella, las rutas se niegan para que nadie gaste tu cuota de Google.
RADAR_TOKEN=

# URL pública para los enlaces de demo (por ejemplo https://radar-pyme.vercel.app).
RADAR_URL_PUBLICA=
